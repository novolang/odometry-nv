@test
fn test_the_odometer_follows_the_reference_arc_step_by_step_across_the_counter_wrap()
    let c = counts()
    let w = want()
    var o = odometry.odometer(machine(), 16)
    o = odometry.update(o, c[0], c[1], 0.02 as fp32)
    test.assert(o.started)
    for k in 0..80
        o = odometry.update(o, c[(k + 1) * 2], c[(k + 1) * 2 + 1], 0.02 as fp32)
        test.assert(near(o.pose.x, w[k * 5]))
        test.assert(near(o.pose.y, w[k * 5 + 1]))
        test.assert(near(o.pose.theta, w[k * 5 + 2]))
        test.assert(near(o.twist.v, w[k * 5 + 3]))
        test.assert(near(o.twist.w, w[k * 5 + 4]))

@test
fn test_a_velocity_command_becomes_the_reference_wheel_speeds_under_limits()
    let t = commands()
    let lim = odometry.limits(0.8, 3.0, 30.0)
    for i in 0..12
        let wheels = odometry.wheel_speeds(machine(), odometry.twist(t[i * 4] as fp32, t[i * 4 + 1] as fp32), lim)
        test.assert(near(wheels.left, t[i * 4 + 2]))
        test.assert(near(wheels.right, t[i * 4 + 3]))
