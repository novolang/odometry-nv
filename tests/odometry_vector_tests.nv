// odometry_vector_tests.nv — the odometer and the command against a
// reference, step by step.
//
// GENERATED by tests/fixtures/odometry_reference.py; do not edit by hand.
// The reference is float64 and takes the arc of a step from the
// textbook formula, `x' = x + R (sin(theta + dtheta) - sin theta)`, which
// shares no expression with the package's chord form.  The wheel counts
// are a pseudo-random walk of two sixteen-bit counters that both cross
// the wrap, and the counter step is Python's modular integer
// arithmetic.  The commands are clipped and scaled by the rule the
// package states, written out separately.
//
// The tolerance on a pose is `TOL`, relative to one plus the magnitude
// of the number: binary32 carries about seven digits, the eighty steps
// agree with the float64 reference to better than 1e-6, and 1e-5 is
// ten times that.

use std.test
use odometry

const TOL = 0.00001

// Whether a binary32 answer is within `TOL` of the reference's, relative
// to one plus the reference's magnitude.
fn near(got: fp32, want: Float) -> Bool
    math.abs(got as Float - want) <= TOL * (1.0 + math.abs(want))

fn machine() -> Params
    odometry.params(0.0325, 0.287, 1440)

