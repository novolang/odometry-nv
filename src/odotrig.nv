// odotrig — the sine and the cosine in single precision, and the wrap of
// an angle into one turn, without libm.
//
// `@tier(embedded)` refuses `math.sin` and `math.cos` because each lowers
// to a call into the C maths library.  These are the Cephes routines for
// binary32: a reduction by whole quarter turns, in three parts so that
// the product of the count and pi/2 loses nothing, and a polynomial over
// `[-pi/4, pi/4]`.  Absolute error is at most 2e-7 for `|x|` up to 100,
// which `tests/odotrig_tests.nv` measures against the host's `math`.
//
// The same two functions are in `ahrs-nv`'s `fpmath`; each package
// carries its own so that neither depends on the other.

fn pio2_hi() -> fp32 []
    1.5703125

fn pio2_mid() -> fp32 []
    0.0004837512969970703

fn pio2_lo() -> fp32 []
    7.549789948768648e-8

// The nearest whole number of quarter turns to `x`.
fn quarter_turns(x: fp32) -> Int []
    let zero: fp32 = 0.0
    let two_over_pi: fp32 = 0.6366197723675814
    let half: fp32 = 0.5
    let t = x * two_over_pi
    if t < zero
        return (t - half) as Int
    (t + half) as Int

// `x` less `n` quarter turns, in `[-pi/4, pi/4]`.
fn reduce(x: fp32, n: Int) -> fp32 []
    let k = n as fp32
    x - k * pio2_hi() - k * pio2_mid() - k * pio2_lo()

// `sin(r)` for `r` in `[-pi/4, pi/4]`.
fn sin_poly(r: fp32) -> fp32 []
    let c1: fp32 = -1.9515295891e-4
    let c2: fp32 = 8.3321608736e-3
    let c3: fp32 = -1.6666654611e-1
    let z = r * r
    ((c1 * z + c2) * z + c3) * z * r + r

// `cos(r)` for `r` in `[-pi/4, pi/4]`.
fn cos_poly(r: fp32) -> fp32 []
    let c1: fp32 = 2.443315711809948e-5
    let c2: fp32 = -1.388731625493765e-3
    let c3: fp32 = 4.166664568298827e-2
    let half: fp32 = 0.5
    let one: fp32 = 1.0
    let z = r * r
    ((c1 * z + c2) * z + c3) * z * z - half * z + one

// The sine of `x`, in radians.
//
// ```novo
// use odotrig
//
// fn main() [io]
//     let s = odotrig.sin(0.5235988)
//     println("${s > 0.499999 and s < 0.500001}")   // true
// ```
pub fn sin(x: fp32) -> fp32 []
    let n = quarter_turns(x)
    let r = reduce(x, n)
    let q = n & 3
    if q == 0
        return sin_poly(r)
    if q == 1
        return cos_poly(r)
    if q == 2
        return -sin_poly(r)
    -cos_poly(r)

// The cosine of `x`, in radians.
//
// ```novo
// use odotrig
//
// fn main() [io]
//     println("${odotrig.cos(0.0)}")   // 1
// ```
pub fn cos(x: fp32) -> fp32 []
    let n = quarter_turns(x)
    let r = reduce(x, n)
    let q = n & 3
    if q == 0
        return cos_poly(r)
    if q == 1
        return -sin_poly(r)
    if q == 2
        return -cos_poly(r)
    sin_poly(r)

// `a` brought into `(-pi, pi]` by whole turns.
//
// ```novo
// use odotrig
//
// fn main() [io]
//     let a = odotrig.wrap_pi(7.0)
//     println("${a > 0.7168 and a < 0.7169}")   // true
// ```
pub fn wrap_pi(a: fp32) -> fp32 []
    let pi: fp32 = 3.141592653589793
    let two_pi: fp32 = 6.283185307179586
    let zero: fp32 = 0.0
    let half: fp32 = 0.5
    let turns = a / two_pi
    let whole = if turns < zero
        (turns - half) as Int
    else
        (turns + half) as Int
    let r = a - whole as fp32 * two_pi
    if r > pi
        return r - two_pi
    if r <= -pi
        return r + two_pi
    r
