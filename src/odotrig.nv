// odotrig — the wrap of an angle into one turn, in single precision,
// without libm.
//
// The sine and the cosine that the pose integration needs are fpmath-nv's.

// `a` brought into `(-pi, pi]` by whole turns.
//
// ```novo
// use odotrig
//
// fn main() [io]
//     let a = odotrig.wrap_pi(7.0)
//     println("${a > 0.7168 and a < 0.7169}")   // true
// ```
pub fn wrap_pi(a: fp32) -> fp32 []
    let pi: fp32 = 3.141592653589793
    let two_pi: fp32 = 6.283185307179586
    let zero: fp32 = 0.0
    let half: fp32 = 0.5
    let turns = a / two_pi
    let whole = if turns < zero
        (turns - half) as Int
    else
        (turns + half) as Int
    let r = a - whole as fp32 * two_pi
    if r > pi
        return r - two_pi
    if r <= -pi
        return r + two_pi
    r
